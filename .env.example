# Chat model, any LiteLLM model string. Azure example: azure/<deployment-name>
MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...
# Prompt version: prompts/<version>/
PROMPT_VERSION=graph_v2
# Optional tracing. Without these keys the app runs untraced.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps local traces apart from the deployed app's in the Langfuse UI
LANGFUSE_TRACING_ENVIRONMENT=development
